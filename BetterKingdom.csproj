<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BepInEx IL2CPP（be 版 / Il2CppInterop 1.5.x）插件需面向 net6.0，与游戏 core 中的实际程序集匹配 -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BetterKingdom</AssemblyName>
    <!-- 插件元信息（BepInEx.PluginInfoProps 据此生成 obj 下的 PluginInfo.cs） -->
    <BepInExPluginGuid>KingdomMod.BetterKingdom</BepInExPluginGuid>
    <BepInExPluginName>BetterKingdom</BepInExPluginName>
    <BepInExPluginVersion>1.0.0</BepInExPluginVersion>
    <Version>1.0.0</Version>
    <Description>Kingdom Two Crowns 功能增强模组</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- 引用均来自游戏目录副本，Private=false 不随插件输出，避免依赖污染 -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- 游戏 interop 程序集的间接依赖引用了 .NET6 BCL，与 netstandard2.1 框架版本冲突，仅为编译期噪音，不影响运行 -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- 游戏安装目录（换机器或换安装路径时只改这里） -->
    <GameDir>D:\Steam\steamapps\common\Kingdom Two Crowns</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅保留 PluginInfoProps：编译期生成 PluginInfo.cs，不带来运行时程序集 -->
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" PrivateAssets="all" />
  </ItemGroup>

