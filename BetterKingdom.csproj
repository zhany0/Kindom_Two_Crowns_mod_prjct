  <!-- 编译后自动部署到游戏 BepInEx\plugins 目录；游戏目录不存在时跳过，不影响编译 -->
  <Target Name="CopyToGamePlugins" AfterTargets="Build" Condition="Exists('$(GameDir)')">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)"
          SkipUnchangedFiles="true" />
    <Message Text="已部署: $(TargetPath) -> $(GameDir)\BepInEx\plugins\$(AssemblyName)" Importance="high" />
  </Target>

